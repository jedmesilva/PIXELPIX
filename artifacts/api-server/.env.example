# Railway provides PORT automatically. Do not set a fixed value in production.
NODE_ENV=production

# Required: PostgreSQL connection string for the Supabase project above.
# It must use a Supabase direct or pooler PostgreSQL host; the server rejects
# other PostgreSQL providers during startup.
DATABASE_URL=

# Required in production for /api/admin/* access.
ADMIN_ACCESS_KEY=

# Keep this value stable across deploys; it signs and encrypts certificate
# tokens. Use the same value that issued any existing certificates.
SESSION_SECRET=

# Supabase project identity and server-side verification.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations.
WEBHOOK_SECRET=
EFI_ENVIRONMENT=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_CERTIFICATE_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_TOKEN=
EFI_WEBHOOK_URL=
CAPTCHA_VERIFY_URL=
CAPTCHA_SECRET=
# Railway production: store the Resend API key as a Railway secret.
# Local Replit development can use the connected Resend integration instead.
RESEND_API_KEY=
# Must be a sender from a verified Resend domain in production.
CERTIFICATE_FROM_EMAIL=
CERTIFICATE_REPLY_TO=
# Optional only when SESSION_SECRET is set. Prefer a dedicated stable secret.
CERTIFICATE_TOKEN_SECRET=
# Required: public frontend URL used to build certificate and redemption links.
PUBLIC_APP_URL=
LOG_LEVEL=info
TRUST_PROXY_HOPS=1