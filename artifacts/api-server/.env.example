# Railway provides PORT automatically. Do not set a fixed value in production.
NODE_ENV=production

# Required: PostgreSQL connection string for the Supabase project above.
# It must use a Supabase direct or pooler PostgreSQL host; the server rejects
# other PostgreSQL providers during startup.
DATABASE_URL=

# Required in production for /api/admin/* access.
ADMIN_ACCESS_KEY=

# Supabase project identity and server-side verification.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations.
WEBHOOK_SECRET=
EFI_ENVIRONMENT=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_CERTIFICATE_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_TOKEN=
EFI_WEBHOOK_URL=
CAPTCHA_VERIFY_URL=
CAPTCHA_SECRET=
CERTIFICATE_DELIVERY_URL=
CERTIFICATE_DELIVERY_SECRET=
# Used to sign certificate tokens. SESSION_SECRET is used as a fallback.
CERTIFICATE_TOKEN_SECRET=
# Public URL used to build the certificate redemption link.
PUBLIC_APP_URL=https://pixelpix.com.br
LOG_LEVEL=info
TRUST_PROXY_HOPS=1