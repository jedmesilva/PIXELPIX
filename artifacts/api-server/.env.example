# Railway provides PORT automatically. Do not set a fixed value in production.
NODE_ENV=production

# Required: PostgreSQL connection string for the existing Supabase database.
DATABASE_URL=

# Required in production for /api/admin/* access.
ADMIN_ACCESS_KEY=

# Supabase credentials used by optional certificate/payment integrations.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations.
WEBHOOK_SECRET=
CAPTCHA_VERIFY_URL=
CAPTCHA_SECRET=
CERTIFICATE_DELIVERY_URL=
CERTIFICATE_DELIVERY_SECRET=
LOG_LEVEL=info
TRUST_PROXY_HOPS=1